apiVersion: apps/v1
kind: Deployment
metadata:
  name: n8n-main
  namespace: {{ .Values.global.namespace }}
spec:
  replicas: {{ .Values.main.replicaCount }}
  selector:
    matchLabels:
      app: n8n-main
  template:
    metadata:
      labels:
        app: n8n-main
    spec:
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            podAffinityTerm:
              labelSelector:
                matchExpressions:
                - key: app
                  operator: In
                  values:
                  - n8n-main
              topologyKey: kubernetes.io/hostname
      containers:
      - name: n8n-main
        image: {{ .Values.main.image.repository }}:{{ .Values.main.image.tag }}
        imagePullPolicy: {{ .Values.main.image.pullPolicy }}
        ports:
