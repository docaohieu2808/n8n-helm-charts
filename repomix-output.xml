    repository: n8nio/n8n
    tag: "1.120.4"
    pullPolicy: IfNotPresent

  resources:
    requests:
      memory: "1Gi"
      cpu: "1000m"
    limits:
      memory: "4Gi"
      cpu: "2000m"

  service:
    type: ClusterIP
    port: 80
    targetPort: 5678
    metricsPort: 9090

# n8n webhook service
webhook:
  enabled: true
  replicaCount: 2
  image:
    repository: n8nio/n8n
    tag: "1.120.4"
    pullPolicy: IfNotPresent

  resources:
