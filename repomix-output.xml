  redisPassword: "vqq0K67ONKCOuCIIMqQyyfeLANFqex4e8eI7AyVio5eUpuaULfenwIxW2I"
  redisEncryptionKey: "082b643762a5d088cfaefc9f937e848dd26bef200615ae37d848b3e277263e65"

# Ingress configuration
